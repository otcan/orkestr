  "rules": [
    {
      "id": "linkedin.alert",
      "event": "job_alert",
      "confidence": 95,
      "gate": "none",
      "when": {
        "sources": [
          "linkedin"
        ],
        "from_prefix": [
          "jobalerts-noreply",
          "jobs-listings"
        ]
      }
    },
    {
      "id": "linkedin.inmail",
      "event": "job_alert",
      "confidence": 75,
      "gate": "none",
      "when": {
        "sources": [
          "linkedin"
        ],
        "from_prefix": [
          "inmail-hit-reply",
          "hit-reply"
        ],
        "any": [
          "role",
          "position",
          "opportunity",
          "stelle",
          "projekt",
          "project"
        ]
      }
    },
    {
      "id": "offer",
      "event": "offer",
      "confidence": 85,
      "when": {
        "any": [
          "pleased to offer you",
          "delighted to offer you",
          "happy to offer you",
          "excited to offer you",
          "extend an offer",
          "offer letter",
          "confirmed you for",
          "vertragsangebot",
          "zusage",
          "onboarding",
          "welcome aboard"
        ],
        "none": [
          "keine zusage",
          "leider nicht",
          "unfortunately not",
          "regret to inform",
          "not to move forward",
          "not move forward"
        ],
        "not_sources": [
          "linkedin"
        ]
      }
    },
    {
      "id": "linkedin.rejection",
      "event": "rejection",
      "confidence": 95,
      "when": {
        "sources": [
          "linkedin"
        ],
        "from_prefix": [
          "jobs-noreply"
        ],
        "all": [
          [
            "unfortunately"
          ],
          [
            "not to move forward",
            "not move forward",
            "not moving forward",
            "decided not to"
          ]
        ]
      }
    },
    {
      "id": "rejection.en",
      "event": "rejection",
      "confidence": 90,
      "when": {
        "all": [
          [
            "unfortunately",
            "regret to inform",
            "we regret"
          ],
          [
            "not to move forward",
            "not move forward",
            "not moving forward",
            "other candidates",
            "not be proceeding",
            "not proceed",
            "decided to pursue",
            "position has been filled",
            "not been selected",
            "decided not to"
          ]
        ],
        "none": [
          "move forward with you",
          "moving forward with you",
          "great news",
          "congratulations",
          "confirmed you",
          "onboarding",
          "welcome aboard",
          "freuen uns",
          "gute nachricht",
          "zusage",
          "willkommen"
        ],
        "not_sources": [
          "linkedin"
        ]
      }
    },
    {
      "id": "rejection.en.direct",
      "event": "rejection",
      "confidence": 85,
      "when": {
        "any": [
          "position has been filled",
          "we will not be moving forward",
