          [
            "role",
            "position",
            "opportunity",
            "stelle",
            "vakanz"
          ]
        ],
        "none": [
          "unsubscribe"
        ]
      }
    },
    {
      "id": "reply.in_thread",
      "event": "recruiter_contact",
      "confidence": 75,
      "gate": "thread",
      "when": {
        "in_reply": true
      }
    },
    {
      "id": "outgoing.application",
      "event": "applied",
      "confidence": 90,
      "direction": "outgoing",
      "gate": "none",
      "when": {
        "any": [
          "bewerbung*",
          "application",
          "applying",
          "apply for",
          "lebenslauf",
          "my cv",
          "mein cv",
          "cv attached",
          "resume",
          "profil anbei",
          "anbei mein",
          "anbei finden sie mein",
          "stundensatz",
          "tagessatz",
          "hourly rate",
          "daily rate",
          "verfügbar ab",
          "available from",
          "verfügbarkeit"
