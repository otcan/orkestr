            "is being reviewed",
            "werden geprüft",
            "in prüfung"
          ]
        ],
        "not_sources": [
          "linkedin"
        ]
      }
    },
    {
      "id": "agency.project",
      "event": "job_alert",
      "confidence": 80,
      "gate": "none",
      "when": {
        "sources": [
          "agency:*",
          "platform:*"
        ],
        "in_reply": false,
        "any": [
          "projektanfrage",
          "projekt",
          "project",
          "position",
          "rolle",
          "role",
          "vakanz",
          "opportunity",
          "einsatz"
        ]
      }
    },
    {
      "id": "recruiter.direct",
      "event": "job_alert",
      "confidence": 65,
      "gate": "none",
      "when": {
        "all": [
          [
            "recruiter",
            "talent acquisition",
            "talent partner",
            "headhunter",
            "personalberater*"
