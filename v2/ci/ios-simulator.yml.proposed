# Proposal only. Not installed in .github/workflows; macOS is not yet allowed
# by repository workflow policy. Requires independent policy/tooling review.
name: Orkestr v2 unsigned iOS simulator probe
on:
  pull_request:
    paths: ['v2/**', '.github/workflows/v2-ios.yml']
permissions:
  contents: read
concurrency:
  group: v2-ios-${{ github.event.pull_request.number || github.ref }}
  cancel-in-progress: true
jobs:
  ios-simulator:
    runs-on: macos-14
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@d23441a48e516b6c34aea4fa41551a30e30af803 # v6.1.0
        with:
          ref: ${{ github.event.pull_request.head.sha || github.sha }}
          persist-credentials: false
      - name: Record native toolchain evidence
        run: |
          sw_vers
          uname -m
          xcodebuild -version
          xcrun --sdk iphonesimulator --show-sdk-version
          xcrun simctl list devices available
      - name: Install exact Rust and CLI
        run: |
          rustup toolchain install 1.99.1 --profile minimal
          rustup target add aarch64-apple-ios-sim --toolchain 1.99.1
          cargo +1.99.1 install dioxus-cli --version '=0.7.3' --locked
          dx --version
      - name: Compile shared client for simulator without signing
        working-directory: v2
        env:
          CARGO_TARGET_DIR: ${{ runner.temp }}/orkestr-v2-ios-target
          ORKESTR_V2_HOME: ${{ runner.temp }}/orkestr-v2-ios-home
          CODE_SIGNING_ALLOWED: 'NO'
          CODE_SIGNING_REQUIRED: 'NO'
        run: cargo +1.99.1 build --locked -p orkestr-v2-ui --no-default-features --features mobile --target aarch64-apple-ios-sim
# This compile is NOT app-bundle/simulator/navigation/keyboard acceptance.
# A reviewed dx bundle/boot/launch step must follow verified exact-version CLI
# flags and simulator architecture; never replace it with a passing echo/skip.
