# Orkestr public alpha configuration.
# Copy to .env for local development. Do not commit real secrets.

ORKESTR_HOST=127.0.0.1
ORKESTR_PORT=19812
ORKESTR_HOME=.orkestr
ORKESTR_RUNTIME_SETTINGS_FILE=.orkestr/runtime-settings.json
# Instance desired/observed state. Existing non-secret runtime settings are
# imported once unless an operator holds migration in compatibility mode.
ORKESTR_INSTANCE_STATE_ROOT=.orkestr/instances
ORKESTR_INSTANCE_CONFIG_AUTO_IMPORT=1

# Public URL used in browser-visible links when Orkestr is exposed.
ORKESTR_PUBLIC_HTTPS_URL=

# Optional public OAuth callback broker for external users, for example
# https://connect.orkestr.app. When set, OAuth connector callbacks use this
# public base instead of a private/local Orkestr URL.
ORKESTR_CONNECT_PUBLIC_URL=

# Default-off canonical application rollout. Assign/migrate opaque references
# before enabling the gateway and link emitter; enable host boundaries last.
ORKESTR_CANONICAL_INSTANCE_URLS=0
ORKESTR_CANONICAL_APP_GATEWAY=0
ORKESTR_CANONICAL_APP_LINKS=0
ORKESTR_HOST_BOUNDARIES=0
ORKESTR_PUBLIC_APP_URL=
# The unauthenticated application root accepts this display name and optional
# comma-separated aliases as routing hints. It never lists or defaults an
# instance; browser access is still bound by the pairing step.
ORKESTR_INSTANCE_NAME=
ORKESTR_INSTANCE_ALIASES=
# Optional direct URL for the operator's primary instance. The instance chooser
# and account menu use it instead of starting another instance pairing flow.
ORKESTR_PRIMARY_INSTANCE_URL=
# Forwarded host/proto values are ignored unless both settings are explicit.
ORKESTR_TRUST_PROXY_HEADERS=0
ORKESTR_TRUSTED_PROXY_IPS=
# Optional no-challenge operator surface behind a local, separately protected
# HTTPS reverse proxy. Every accepted origin must be listed exactly.
ORKESTR_TRUSTED_OPERATOR_PROXY=0
ORKESTR_TRUSTED_OPERATOR_ORIGINS=

# Optional private overlay directory. Keep real credentials, host-specific
# executors, browser profiles, personal prompts, and production bindings there.
ORKESTR_OVERLAY_DIR=

# Optional connector/runtime inputs.
OPENAI_API_KEY=
CODEX_HOME=
# WhatsApp uses Orkestr's integrated local bridge by default.
WHATSAPP_BRIDGE_MODE=local
# Legacy external bridge compatibility is disabled unless explicitly enabled by
# the host operator.
ORKESTR_WHATSAPP_EXTERNAL_BRIDGE_ENABLED=0
# Opt in only after a participant-identity migration dry run is clean.
ORKESTR_WHATSAPP_PARTICIPANT_IDENTITY_V2=0
WHATSAPP_BRIDGE_URL=

# Optional synchronous Vagent voice webhook. Vagent owns STT/TTS and posts
# voice prompts here; Orkestr routes them only to this configured thread.
# Keep the auth value private and set the same literal value in Vagent's
# Authorization-header configuration (no Bearer prefix is added by Orkestr).
ORKESTR_VAGENT_ENABLED=0
ORKESTR_VAGENT_AUTH_TOKEN=
ORKESTR_VAGENT_THREAD_ID=
ORKESTR_VAGENT_TIMEOUT_MS=45000
# Optional existing Orkestr user identity for multi-user installations.
ORKESTR_VAGENT_USER_ID=

# Optional Codex runtime controls for thread leases.
ORKESTR_CODEX_SANDBOX=workspace-write
ORKESTR_CODEX_APPROVAL_POLICY=on-request
ORKESTR_RUNTIME_CODEX_COMMAND=codex --sandbox workspace-write --ask-for-approval on-request --no-alt-screen
ORKESTR_RUNTIME_WORKSPACE_ROOT=
ORKESTR_RUNTIME_SUBMIT_KEYS=C-m
ORKESTR_RUNTIME_SUBMIT_DELAY_MS=250
ORKESTR_WAKE_READY_TIMEOUT_MS=60000
# Generation-scoped Codex rollout validation. shadow records malformed legacy
# rollout metadata while preserving compatibility; enforce rejects it.
ORKESTR_CODEX_GENERATION_ROLLOUT_MODE=off
# Bound explicit runtime-doctor final-projection checks per thread.
ORKESTR_CODEX_GENERATION_DOCTOR_MESSAGE_TAIL_LIMIT=100
ORKESTR_BROWSER_DESKTOP_MODE=profiles
ORKESTR_DEFAULT_DESKTOP_SLUG=desktop
ORKESTR_GMAIL_AUTH_DESKTOP_SLUG=gmail
ORKESTR_MANUAL_INTERVENTION_DESKTOP_SLUG=desktop

# Unified per-thread resource grants use a transactional SQLite WAL database.
# Set desktop/oxrm from shadow to enforce only after explicit grants are present.
# Shadow records would-deny decisions but preserves legacy target selection;
# enforce removes ungranted thread-scoped targets. Mailbox shadow preserves the
# legacy connector inbox and only audits listener would-allow/would-deny; only
# enforce enables exact-listener dispatch. Keep mailbox off until registrations
# and exact thread grants are ready.
# Resource IDs are bound to the owner and tenant/VM boundary. The instance
# lifecycle must register an active resource before it can be granted; grants
# never provision resources, credentials, endpoints, or mailbox infrastructure.
# Desktop catalog compatibility applies only in off/shadow. For strict
# default-deny deployment, set desktop, oxrm, and mailbox access modes to
# enforce after their lifecycles have registered resources and grants exist.
ORKESTR_THREAD_RESOURCE_POLICY_STORE=sqlite
ORKESTR_THREAD_RESOURCE_POLICY_DB=
ORKESTR_DESKTOP_ACCESS_MODE=shadow
# Optional staged enforcement. Each entry must bind one exact thread to an
# exact desktop resource ID. Protecting either side also blocks mismatched
# thread/desktop combinations; malformed non-empty JSON fails closed.
ORKESTR_DESKTOP_ENFORCED_BINDINGS_JSON=[]
ORKESTR_OXRM_ACCESS_MODE=shadow
ORKESTR_MAILBOX_ACCESS_MODE=off
# Keep shadow-only target warnings off until operators are ready to surface
# rollout gaps in thread history (and eligible WhatsApp-bound threads).
ORKESTR_SHADOW_BOUNDARY_CHAT_WARNINGS=0
# Policy writes remain unified by default. legacy/dual are reported unsupported
# unless a resource grows a real legacy writer; mailbox rollback is ingress-only
# (set its access mode off) and preserves unified policy records.
ORKESTR_THREAD_RESOURCE_WRITE_MODE=unified
# `orkestr doctor system --json` includes aggregate policy store, queue,
# evidence, stale-work, write-mode, and break-glass diagnostics.
ORKESTR_THREAD_RESOURCE_DOCTOR_EVENT_LIMIT=500
# Enabled mailbox listeners are reclaimed by a lease-protected bounded pump.
# The policy-outage replay pump uses the same limit and retries safely from the
# instance-owned connector spool once transactional policy is healthy again.
ORKESTR_MAILBOX_THREAD_DELIVERY_PUMP_INTERVAL_MS=5000
ORKESTR_MAILBOX_THREAD_DELIVERY_PUMP_LIMIT=25
ORKESTR_MAILBOX_POLICY_REPLAY_RETRY_MS=5000

# Recipient public-key encryption for generated/published attachments. Enroll
# and verify at least one age recipient in Instance Settings before requiring
# encryption. The private identity is never stored or sent to the server.
ORKESTR_ATTACHMENT_ENCRYPTION_REQUIRED=0
# Optional non-secret registry location and possession-challenge lifetime.
ORKESTR_ATTACHMENT_ENCRYPTION_FILE=
ORKESTR_ATTACHMENT_ENCRYPTION_MIGRATIONS_FILE=
ORKESTR_ATTACHMENT_KEY_CHALLENGE_TTL_MS=900000

# Optional parent-managed connector OAuth apps. These configure the app once;
# each user still connects their own account from chat.
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REDIRECT_URI=
# Production installs generate this automatically. Keep it outside ORKESTR_HOME.
ORKESTR_CONNECTOR_ENCRYPTION_KEY=
# The public verification profile is send-only. Use "all" only for a separately reviewed development client.
ORKESTR_GOOGLE_OAUTH_ALLOWED_CAPABILITIES=gmail_send
# Named profiles are optional; legacy GMAIL_OAUTH_* values remain the default.
ORKESTR_GOOGLE_OAUTH_DEFAULT_APP=default
ORKESTR_GOOGLE_OAUTH_APPS_JSON=

# Optional job-alert mail ingress. Configure a receiving domain and a relay you
# control. The relay must send its bearer token to POST /api/jobs/inbound-email.
# Do not put the real token in the public repository.
ORKESTR_JOB_ALERT_INBOUND_DOMAIN=
ORKESTR_JOB_ALERT_RELAY_TOKEN=

# Optional outbound mail for Orkestr-owned drafts. Gmail API access is not
# required for this path.
ORKESTR_MAIL_PROVIDER=smtp
ORKESTR_SMTP_HOST=
ORKESTR_SMTP_PORT=587
ORKESTR_SMTP_USER=
ORKESTR_SMTP_PASS=
ORKESTR_SMTP_FROM=
OUTLOOK_OAUTH_CLIENT_ID=
OUTLOOK_OAUTH_TENANT_ID=common
OUTLOOK_OAUTH_SCOPES=offline_access User.Read Mail.Read
JIRA_OAUTH_CLIENT_ID=
JIRA_OAUTH_CLIENT_SECRET=
JIRA_OAUTH_REDIRECT_URI=
JIRA_OAUTH_SCOPES=read:jira-user read:jira-work offline_access
SHOPIFY_OAUTH_CLIENT_ID=
SHOPIFY_OAUTH_CLIENT_SECRET=
SHOPIFY_OAUTH_REDIRECT_URI=
SHOPIFY_OAUTH_SCOPES=read_products,read_orders
# WebUI-origin replies can be mirrored only through a server-authored intent.
# Set to 0 for rollback. A non-empty thread-ID list limits rollout to canaries.
ORKESTR_WEBUI_WHATSAPP_REPLY_DELIVERY=1
ORKESTR_WEBUI_WHATSAPP_REPLY_DELIVERY_THREAD_IDS=
ORKESTR_WEBUI_WHATSAPP_REPLY_ORPHAN_GRACE_MS=120000
